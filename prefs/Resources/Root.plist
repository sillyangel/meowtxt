<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>meowtxt</string>
			<key>footerText</key>
			<string>Enable or disable the meowtxt web &amp; REST API daemon on port 8737.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>dev.sillyangel.meowtxt</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enabled</string>
			<key>PostNotification</key>
			<string>dev.sillyangel.meowtxt/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Access Token</string>
			<key>footerText</key>
			<string>Use this token to authenticate with the meowtxt web client or REST API.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Token</string>
			<key>get</key>
			<string>tokenValue:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Copy Token</string>
			<key>action</key>
			<string>copyToken</string>
		</dict>
	</array>
	<key>title</key>
	<string>meowtxt</string>
</dict>
</plist>
